{
  "name": "rate1-app-api",
  "private": true,
  "version": "0.1.0",
  "description": "Rate 1 dashboard API on app.<domain>: authentication (email, Google, MFA) and tenant authorization",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
