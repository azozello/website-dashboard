# Copy to .env for `npm run dev` / `npm run migrate`. Never commit .env.
# ENV unset = local development: dev secret allowed, emails printed to the log.
ENV=
DATABASE_URL=postgres://rate1:rate1@127.0.0.1:5434/rate1
# Browser origin of the dashboard. Vite dev server in development; https://app.<domain> when deployed.
APP_BASE_URL=http://localhost:5173
COLLECT_BASE_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8081

# Required when deployed: at least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=

# Optional locally. Google sign-in and the Search Console connection are enabled only when both are set.
# Authorized redirect URIs: <APP_BASE_URL>/api/auth/callback/google and <APP_BASE_URL>/api/gsc/callback
# (scripts/set-google-oauth.ps1 fills these two from a downloaded OAuth client JSON).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Search Console refresh tokens: 32 random bytes, base64 (openssl rand -base64 32).
# Unset locally: a fixed development key is used. Required when deployed for Search Console.
TOKEN_ENCRYPTION_KEY=

# Required when deployed, e.g. smtps://user:pass@smtp.example.eu:465
SMTP_URL=
MAIL_FROM=Rate 1 <no-reply@example.com>

# Header the reverse proxy sets to the real client IP (replacing any client value).
CLIENT_IP_HEADER=x-forwarded-for
# RATE_LIMIT=off disables the auth rate limits (tests only).
RATE_LIMIT=
