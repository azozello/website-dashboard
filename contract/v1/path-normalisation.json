    ["https://site.example/Preise/Physio/?gclid=abc", "/Preise/Physio"],
    ["/", "/"],
    ["", "/"],
    ["/back-pain", "/back-pain"],
    ["/back-pain/", "/back-pain"],
    ["/Back-Pain///", "/Back-Pain"],
    ["/a/b/?x=1", "/a/b"],
    ["/a#frag", "/a"],
    ["/a?x=1#frag", "/a"],
    ["/%C3%BCber-uns/", "/über-uns"],
    ["/caf%C3%A9", "/café"],
    ["/100%25", "/100%"],
    ["/a%20b", "/a b"],
    ["/bad%E0%A4%A", "/bad%E0%A4%A"],
    ["/a%20b%", "/a%20b%"],
    ["/50%off/", "/50%off"],
