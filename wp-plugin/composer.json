{
    "name": "rate1/rate1-connector-dev",
    "description": "Dev tooling for the rate1-connector WordPress plugin (not shipped).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "test:unit": "php tests/unit/run.php",
        "build": "php build.php"
    }
}
