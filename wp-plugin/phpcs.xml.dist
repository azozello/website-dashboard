<?xml version="1.0"?>
<ruleset name="rate1-connector">
	<description>WordPress Coding Standards + PHP 7.4 compatibility for the shipped plugin.</description>

	<file>./rate1-connector</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.3"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rate1-connector"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rate1_connector"/>
				<element value="Rate1_Connector"/>
				<element value="RATE1_CONNECTOR"/>
			</property>
		</properties>
	</rule>
</ruleset>
