# Template for /opt/rate1/.env. The real file exists only on the server: cloud-init generates it on first boot
# with random secrets. Never commit a filled-in copy.

# --- Data Contract v1 §2 ---
ENV=test                         # test | prod  (test enables GET /v1/_echo on collect)
DATABASE_URL=                    # not read from this file: docker-compose.yml builds one per service
                                 # (ingest -> ingest_rw, api -> app_rw, api-migrate -> postgres)
COLLECT_BASE_URL=https://collect.example.com
APP_BASE_URL=https://app.example.com
TRUSTED_PROXY_CIDRS=172.30.0.0/24,fd00:30::/64  # the Compose "edge" network (IPv4 + IPv6); Caddy is the only proxy in it
CLIENT_IP_HEADER=X-Forwarded-For
GOOGLE_CLIENT_ID=                # written by deploys from the GitHub secret of the same name (merge-secrets.sh)
GOOGLE_CLIENT_SECRET=            # as above
TOKEN_ENCRYPTION_KEY=            # 32 random bytes, base64

# --- App API (api/): sign-in and tenants. Don't edit by hand; deploys keep these up to date.
BETTER_AUTH_SECRET=              # generated on the server by the first deploy; signs sessions. Changing it signs everyone out.
SMTP_URL=                        # from the SMTP_URL GitHub secret (required), e.g. smtps://user:pass@smtp.example.eu:465
MAIL_FROM=                       # from the MAIL_FROM GitHub secret; default 'Rate 1 <no-reply@<DOMAIN>>'

# --- Server-only ---
DOMAIN=example.com               # Caddy serves collect.<DOMAIN> and app.<DOMAIN>
POSTGRES_PASSWORD=               # superuser "postgres"
INGEST_DB_PASSWORD=              # role ingest_rw
APP_DB_PASSWORD=                 # role app_rw
INGEST_IMAGE=                    # unused: images are built on the server (deploy.sh); cloud-init still writes it
APP_IMAGE=                       # unused, as above
